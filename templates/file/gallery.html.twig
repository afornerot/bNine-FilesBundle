{% set compact = compact|default(false) %}
{% set select = select|default('') %}
{% set _is_iframe = select != '' %}

{# En mode iframe (select != vide), on charge les assets minimaux.
   Sinon (rendu via render(controller(...))), l'app hote a deja tout charge
   dans son layout principal. #}
{% if _is_iframe %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if select == 'multiple' %}Sélectionner des images{% else %}Sélectionner une image{% endif %}</title>
    <link rel="stylesheet" href="{{ asset('bundles/bninefiles/lib/css/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ asset('bundles/bninefiles/lib/css/fontawesome.min.css') }}">
    <link rel="stylesheet" href="{{ asset('bundles/bninefiles/css/bninefiles.css') }}">
    <script src="{{ asset('bundles/bninefiles/lib/js/jquery.min.js') }}"></script>
    <script src="{{ asset('bundles/bninefiles/lib/js/bootstrap.bundle.min.js') }}"></script>
    <script src="{{ asset('bundles/bninefiles/js/bninefiles.js') }}"></script>
</head>
<body>
{% endif %}

<div id="file-gallery-{{ domain }}-{{ id|e('html_attr') }}"
     class="file-gallery"
     data-domain="{{ domain }}"
     data-id="{{ id }}"
     data-instance="gallery-{{ domain }}-{{ id }}-{{ editable ? 'write' : 'read' }}{{ select ? '-select-' ~ select : '' }}"
     data-base-path="{{ path('bninefiles_files_gallery', { domain: domain, id: id, editable: editable, compact: compact ? 1 : null, select: select ?: null }) }}"
     data-current-path="{{ path }}"
     data-delete-url="{{ path('bninefiles_files_delete', { domain: domain, id: id }) }}"
     data-mkdir-url="{{ path('bninefiles_files_mkdir', { domain: domain, id: id }) }}"
     data-select="{{ select }}"
    >

    {% if not compact %}
    <div class="card mt-3">
        <div class="card-header">Galérie</div>
        <div class="card-body">
    {% endif %}

            {% if select and not compact %}
                <div class="alert alert-info mb-3 py-2">
                    <i class="fas fa-info-circle me-1"></i>
                    {% if select == 'multiple' %}
                        Sélectionnez les images souhaitées puis cliquez sur <strong>Valider</strong>.
                    {% else %}
                        Cliquez sur une image pour la sélectionner.
                    {% endif %}
                </div>
            {% endif %}

            {% if editable %}
                <div class="mb-3 d-flex align-items-center justify-content-between flex-wrap">
                    <div class="btn-group mb-2 mb-md-0" role="group">
                        <button type="button"
                            class="btn btn-info bnine-upload-btn"
                            data-upload-url="{{ path('bninefiles_files_uploadmodal',{domain:domain, id:id,path:path,imageOnly:1}) }}"
                            data-gallery-id="file-gallery-{{ domain }}-{{ id|e('html_attr') }}"
                            data-domain="{{ domain }}"
                            data-id="{{ id }}"
                            data-path="{{ path }}"
                            data-compact="{{ compact ? 1 : 0 }}"
                            data-select="{{ select }}"
                            title="Téléverser des images">
                            <i class="fas fa-upload me-1"></i> Upload
                        </button>
                        <button type="button"
                            class="btn btn-info"
                            data-bs-toggle="modal"
                            data-bs-target="#mymodaldir-{{ domain }}-{{ id|e('html_attr') }}"
                            title="Créer un répertoire">
                            <i class="fas fa-folder-plus me-1"></i> Dossier
                        </button>
                    </div>
                </div>
            {% endif %}

            <div class="mb-3">
                <nav aria-label="breadcrumb" class="mb-3">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="#" class="gallery-nav" data-path=""><i class='fas fa-home'></i></a>
                        </li>
                        {% if path %}
                            {% set segments = path|split('/') %}
                            {% set currentPath = '' %}
                            {% for segment in segments %}
                                {% set currentPath = currentPath ~ (currentPath ? '/' : '') ~ segment %}
                                <li class="breadcrumb-item{{ loop.last ? ' active' : '' }}" {% if loop.last %}aria-current="page"{% endif %}>
                                    {% if not loop.last %}
                                        <a href="#" class="gallery-nav" data-path="{{ currentPath }}">{{ segment }}</a>
                                    {% else %}
                                        {{ segment }}
                                    {% endif %}
                                </li>
                            {% endfor %}
                        {% endif %}
                    </ol>
                </nav>
            </div>

            {% set parentPath = path|split('/')|slice(0, -1)|join('/') %}

            {% if path %}
                <div class="mb-2">
                    <a href="#" class="gallery-nav text-decoration-none text-muted" data-path="{{ parentPath }}">
                        <i class="fas fa-level-up-alt me-1"></i> <strong>..</strong>
                    </a>
                </div>
            {% endif %}

            <div class="file-gallery-grid">
                {% for file in files %}
                    {% if file.isDirectory %}
                        <div class="file-gallery-item d-flex align-items-center justify-content-center" style="aspect-ratio: auto;">
                            <a href="#" class="gallery-nav text-decoration-none fw-semibold p-3" data-path="{{ path ? path ~ '/' ~ file.name : file.name }}">
                                <i class="fas fa-folder text-warning me-2"></i>{{ file.name }}/
                            </a>
                            {% if editable and not select %}
                                <button type="button" class="btn btn-sm btn-danger file-gallery-delete btn-delete" data-path="{{ file.path }}" title="Supprimer le dossier">
                                    <i class="fas fa-trash"></i>
                                </button>
                            {% endif %}
                        </div>
                    {% else %}
                            {% if select %}
                            <div class="file-gallery-item selectable"
                                 data-file-url="{{ path('bninefiles_files_image', { domain: domain, id: id, path: file.path }) }}"
                                 data-file-path="{{ domain }}/{{ id }}/{{ file.path }}"
                                 data-file-name="{{ file.name }}">
                                <div class="select-checkbox"><i class="fas fa-check"></i></div>
                                <div class="select-overlay"><i class="fas fa-check-circle text-white fa-2x"></i></div>
                                <img src="{{ path('bninefiles_files_thumbnail', { domain: domain, id: id, path: file.path }) }}"
                                     alt="{{ file.name }}"
                                     title="{{ file.name }}"
                                     loading="lazy">
                                {% if editable %}
                                    <button type="button" class="btn btn-sm btn-danger file-gallery-delete btn-delete"
                                            data-path="{{ file.path }}"
                                            title="Supprimer"
                                            style="position:absolute;top:0.25rem;right:0.25rem;transition:opacity .2s;z-index:2;">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                {% endif %}
                            </div>
                            {% else %}
                            <div class="file-gallery-item">
                                <a href="{{ path('bninefiles_files_image', { domain: domain, id: id, path: file.path }) }}"
                                   class="glightbox"
                                   data-gallery="gallery-{{ domain }}-{{ id }}">
                                    <img src="{{ path('bninefiles_files_thumbnail', { domain: domain, id: id, path: file.path }) }}"
                                         alt="{{ file.name }}"
                                         title="{{ file.name }}"
                                         loading="lazy">
                                </a>
                                {% if editable %}
                                    <button type="button" class="btn btn-sm btn-danger file-gallery-delete btn-delete" data-path="{{ file.path }}" title="Supprimer">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                {% endif %}
                            </div>
                            {% endif %}
                    {% endif %}
                {% else %}
                    <div class="text-muted p-3"><em>Aucune image</em></div>
                {% endfor %}
            </div>

            {% set nonImageFiles = [] %}
            {% for file in allFiles %}
                {% if not file.isDirectory %}
                    {% set ext = file.name|split('.')|last|lower %}
                    {% set imageExts = ['jpg','jpeg','png','gif','webp','svg','bmp','tiff','tif'] %}
                    {% if ext not in imageExts %}
                        {% set nonImageFiles = nonImageFiles|merge([file]) %}
                    {% endif %}
                {% endif %}
            {% endfor %}

            {% if nonImageFiles|length > 0 %}
                <div class="mt-3">
                    <h6 class="text-muted mb-2"><i class="fas fa-file me-1"></i> Autres fichiers</h6>
                    <ul class="list-group">
                        {% for file in nonImageFiles %}
                            <li class="list-group-item d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-file text-secondary me-2"></i>
                                    <a href="{{ path('bninefiles_files_download', { domain: domain, id: id, path: file.path }) }}"
                                       target="_blank"
                                       class="text-decoration-none">
                                        {{ file.name }}
                                    </a>
                                </div>
                                {% if editable %}
                                    <button class="btn btn-sm btn-outline-danger btn-delete" data-path="{{ file.path }}" title="Supprimer">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

    {% if not compact %}
        </div>
    </div>
    {% endif %}

    {# Bouton Valider : toujours visible en mode multiple, sticky en haut de la modale #}
    {% if select == 'multiple' %}
    <div class="bnine-gallery-sticky-validate">
        <button type="button" class="btn btn-success btn-validate-selection" disabled>
            <i class="fas fa-check me-1"></i>Valider (<span class="selection-count">0</span>)
        </button>
        <button type="button" class="btn btn-outline-secondary btn-cancel-selection">
            <i class="fas fa-times me-1"></i>Annuler
        </button>
    </div>
    {% endif %}

    <div id="mymodaldir-{{ domain }}-{{ id|e('html_attr') }}" class="modal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">CREATION REPERTOIRE</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="input-group mb-3">
                        <input type="text" class="form-control"
                               placeholder="Nom du dossier"
                               id="new-folder-name-{{ domain }}-{{ id|e('html_attr') }}">
                        <button class="btn btn-success"
                                data-container-id="file-gallery-{{ domain }}-{{ id|e('html_attr') }}"
                                data-modal-id="mymodaldir-{{ domain }}-{{ id|e('html_attr') }}"
                                data-input-id="new-folder-name-{{ domain }}-{{ id|e('html_attr') }}"
                                id="btn-create-folder-{{ domain }}-{{ id|e('html_attr') }}">Créer dossier</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

<script>
// jQuery, Bootstrap et GLightbox sont chargés ci-dessus par la template
$(function () {
        var selectMode = '{{ select }}';

        var lightbox = null;
        if (!selectMode && typeof GLightbox === 'function') {
            lightbox = GLightbox({
                loop: true,
                touchNavigation: true,
                preload: true
            });
        }

        function refreshContainer(containerId, path) {
            var $oldContainer = $('#' + containerId);
            var base = $oldContainer.data('base-path');

            $.get(base, { path: path }, function (html) {
                var $doc = $('<div>').html(html);
                var $newContainer = $doc.find('#' + containerId);
                if ($newContainer.length) {
                    $oldContainer.replaceWith($newContainer);
                    initGallery($newContainer);
                    if (lightbox) lightbox.reload();

                    // Dispatcher bnine:browse:refresh
                    var detail = {
                        path: path,
                        origin: $oldContainer.data('instance') || null,
                    };
                    if (typeof bnineDispatch === 'function') {
                        bnineDispatch('bnine:browse:refresh', detail, document);
                    } else {
                        var ev;
                        try { ev = new CustomEvent('bnine:browse:refresh', { detail: detail, bubbles: true }); }
                        catch (err) { ev = document.createEvent('CustomEvent'); ev.initCustomEvent('bnine:browse:refresh', true, false, detail); }
                        document.dispatchEvent(ev);
                    }
                }
            });
        }

        function initGallery($container) {
            var containerId = $container.attr('id');

            $container.off('click');

            $container.on('click', '.btn-delete', function (e) {
                e.preventDefault();
                if (!confirm('Supprimer ce fichier ?')) return;

                var pathToDelete = $(this).data('path');
                var currentPath = $container.data('current-path');

                $.ajax({
                    url: $container.data('delete-url'),
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ path: pathToDelete }),
                    success: function (res) {
                        if (res.success) {
                            // Dispatcher bnine:browse:delete avant le refresh
                            var detail = {
                                path: pathToDelete,
                                isDirectory: false, // determine cote serveur, pas dispo ici
                                origin: $container.data('instance') || null,
                            };
                            if (typeof bnineDispatch === 'function') {
                                bnineDispatch('bnine:browse:delete', detail, document);
                            } else {
                                var ev;
                                try { ev = new CustomEvent('bnine:browse:delete', { detail: detail, bubbles: true }); }
                                catch (err) { ev = document.createEvent('CustomEvent'); ev.initCustomEvent('bnine:browse:delete', true, false, detail); }
                                document.dispatchEvent(ev);
                            }
                            refreshContainer(containerId, currentPath);
                        } else {
                            alert('Erreur : ' + res.error);
                        }
                    },
                    error: function (xhr) {
                        alert('Erreur lors de la suppression : ' + xhr.responseText);
                    }
                });
            });
        }

        var containerId = 'file-gallery-{{ domain }}-{{ id|e('html_attr') }}';
        var $gallery = $('#' + containerId);
        initGallery($gallery);

        $('#mymodaldir-{{ domain }}-{{ id|e('html_attr') }}').on('shown.bs.modal', function () {
            $('#new-folder-name-{{ domain }}-{{ id|e('html_attr') }}').trigger('focus');
        });

        $('#new-folder-name-{{ domain }}-{{ id|e('html_attr') }}').on('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                $('#btn-create-folder-{{ domain }}-{{ id|e('html_attr') }}').trigger('click');
            }
        });

        $('#btn-create-folder-{{ domain }}-{{ id|e('html_attr') }}').on('click', function (e) {
            e.preventDefault();

            var $btn = $(this);
            var containerId = $btn.data('container-id');
            var modalId = $btn.data('modal-id');
            var inputId = $btn.data('input-id');

            var $container = $('#' + containerId);
            var $input = $('#' + inputId);
            var folderName = $input.val().trim();
            var currentPath = $container.data('current-path') || '';

            if (!folderName) {
                alert('Veuillez entrer un nom de dossier.');
                return;
            }

            // Validation client : refuse les séparateurs de chemin et caractères réservés Windows.
            // Le serveur revalide en complément (cf. FileService::makeDirectory).
            if (!/^[a-zA-Z0-9\-_\s.]+$/.test(folderName)) {
                alert('Nom de dossier invalide.\nCaractères autorisés : lettres, chiffres, tirets, underscores, espaces, points.');
                return;
            }

            $.post($container.data('mkdir-url'), {
                path: currentPath,
                name: folderName
            }, function (response) {
                if (response.success) {
                    $input.val('');
                    if (bootstrap && bootstrap.Modal) {
                        var modal = bootstrap.Modal.getInstance(document.getElementById(modalId));
                        if (modal) modal.hide();
                    } else {
                        $('#' + modalId).modal('hide');
                    }

                    // Dispatcher bnine:browse:mkdir avant le refresh
                    var detail = {
                        path: (currentPath ? currentPath + '/' : '') + folderName,
                        name: folderName,
                        origin: $container.data('instance') || null,
                    };
                    if (typeof bnineDispatch === 'function') {
                        bnineDispatch('bnine:browse:mkdir', detail, document);
                    } else {
                        var ev;
                        try { ev = new CustomEvent('bnine:browse:mkdir', { detail: detail, bubbles: true }); }
                        catch (err) { ev = document.createEvent('CustomEvent'); ev.initCustomEvent('bnine:browse:mkdir', true, false, detail); }
                        document.dispatchEvent(ev);
                    }

                    refreshContainer(containerId, currentPath);
                } else {
                    alert('Erreur : ' + response.error);
                }
            });
        });

});

// Delegated events for select mode - works even when loaded via AJAX
$(document).off('click.bninefilenav', '.gallery-nav').on('click.bninefilenav', '.gallery-nav', function (e) {
    e.preventDefault();
    var path = $(this).data('path');
    var $gallery = $(this).closest('.file-gallery');
    var containerId = $gallery.attr('id');
    var base = $gallery.data('base-path');

    $.get(base, { path: path }, function (html) {
        var $doc = $('<div>').html(html);
        var $newContainer = $doc.find('#' + containerId);
        if ($newContainer.length) {
            $gallery.replaceWith($newContainer);
        }
    });
});

$(document).off('click.bninefileselect', '.file-gallery-item.selectable').on('click.bninefileselect', '.file-gallery-item.selectable', function (e) {
    // Ignore les clics sur les contrôles internes (bouton delete, checkbox de sélection).
    // Sinon le clic sur 'Supprimer' declenche aussi la selection de l'image et ferme la modale.
    if ($(e.target).closest('.btn-delete, .select-checkbox, .select-overlay, .file-gallery-delete').length) {
        return;
    }
    e.preventDefault();
    e.stopPropagation();
    var $item = $(this);
    var $gallery = $item.closest('.file-gallery');
    var isMultiple = $gallery.find('.btn-validate-selection').length > 0;

    if (isMultiple) {
        $item.toggleClass('selected');
        var count = $gallery.find('.file-gallery-item.selectable.selected').length;
        $gallery.find('.selection-count').text(count);
        $gallery.find('.btn-validate-selection').prop('disabled', count === 0);
    } else {
        var data = {
            url: $item.data('file-url'),
            path: $item.data('file-path'),
            name: $item.data('file-name')
        };
        // Le bundle widget a stocké quel input est actif dans window.parent._bnineActiveInputId.
        // Si défini, on route vers la callback du widget (_bnineSelectRegistry[inputId]).
        // Sinon, fallback sur l'ancienne callback globale bnineFileSelect.
        deliverSelection(data);
    }
});

// Helper : délivre la sélection à la bonne callback.
// On envoie TOUJOURS un array : si l'utilisateur a sélectionné 1 image, c'est [item].
// Le widget single prend items[0], le widget multiple prend items.
function deliverSelection(payload) {
    var items = Array.isArray(payload) ? payload : [payload];
    var parent = window.parent || window;

    // 1. Priorité : inputId dans l'URL de l'iframe (paramètre ajouté par le widget)
    var urlParams = new URLSearchParams(window.location.search);
    var urlInputId = urlParams.get('inputId');

    // 2. Sinon : variable globale _bnineActiveInputId
    var activeId = urlInputId || parent._bnineActiveInputId;

    if (activeId && parent._bnineSelectRegistry && typeof parent._bnineSelectRegistry[activeId] === 'function') {
        // Toujours passer un array, le widget décide quoi en faire
        parent._bnineSelectRegistry[activeId](items);
        if (parent && typeof parent.BnineModalClose === 'function') {
            parent.BnineModalClose();
        }
        return;
    }
    var cb = (typeof window.bnineFileSelect === 'function') ? window.bnineFileSelect : null;
    if (!cb && parent && typeof parent.bnineFileSelect === 'function') {
        cb = parent.bnineFileSelect;
    }
    if (cb) {
        cb(items);
    }
    if (parent && typeof parent.BnineModalClose === 'function') {
        parent.BnineModalClose();
    }
}

$(document).off('click.bninefilevalidate', '.btn-validate-selection').on('click.bninefilevalidate', '.btn-validate-selection', function (e) {
    e.preventDefault();
    var $gallery = $(this).closest('.file-gallery');
    var items = [];
    $gallery.find('.file-gallery-item.selectable.selected').each(function () {
        items.push({
            url: $(this).data('file-url'),
            path: $(this).data('file-path'),
            name: $(this).data('file-name')
        });
    });
    if (items.length > 0) {
        deliverSelection(items);
    }
});

// Bouton "Annuler" : ferme la modale sans sélection
$(document).off('click.bninecancel', '.btn-cancel-selection').on('click.bninecancel', '.btn-cancel-selection', function (e) {
    e.preventDefault();
    if (window.parent && typeof window.parent.BnineModalClose === 'function') {
        window.parent.BnineModalClose();
    } else if (typeof window.BnineModalClose === 'function') {
        window.BnineModalClose();
    }
});

$(document).off('click.bnineupload', '.bnine-upload-btn').on('click.bnineupload', '.bnine-upload-btn', function (e) {
    e.preventDefault();
    var $btn = $(this);
    var url = $btn.data('upload-url');
    var galleryId = $btn.data('gallery-id');
    var domain = $btn.data('domain');
    var id = $btn.data('id');
    var path = $btn.data('path') || '';
    var compact = $btn.data('compact');
    var select = $btn.data('select');

    // Generer un UUID unique pour ce bouton upload du browser
    var widgetId = (typeof bnineUuid === 'function') ? bnineUuid() : ('browser-upload-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8));

    // Injecter l'origin dans l'URL d'upload pour que l'iframe puisse le recuperer
    if (url.indexOf('origin=') === -1) {
        url += (url.indexOf('?') === -1 ? '?' : '&') + 'origin=' + encodeURIComponent(widgetId);
    }

    if (typeof window.BnineModalOpen === 'function') {
        window.BnineModalOpen({
            id: 'mymodalupload-' + domain + '-' + id,
            title: 'Upload images',
            url: url,
            height: '600px',
            widgetId: widgetId,
            endpoint: 'browse'
        });
    }
});

$(document).on('bnine-modal-closed', function () {
    $('.file-gallery').each(function () {
        var $gallery = $(this);
        var galleryId = $gallery.attr('id');
        var base = $gallery.data('base-path');
        var currentPath = $gallery.data('current-path') || '';

        $.get(base, { path: currentPath }, function (html) {
            var $doc = $('<div>').html(html);
            var $newContainer = $doc.find('#' + galleryId);
            if ($newContainer.length) {
                $gallery.replaceWith($newContainer);
            }
        });
    });
});
</script>
</div>

{% if _is_iframe %}
</body>
</html>
{% endif %}
