{% extends 'base.html.twig' %}

{% block localstyle %}
    <style>
        body { background-color: transparent; }
    </style>
{% endblock %}

{% block body %}
    <div class="d-flex gap-2 mb-2">
        <button type="button" class="btn btn-success btn-sm" id="cropSubmit"><i class="fas fa-check"></i> Valider</button>
        <a class="btn btn-secondary btn-sm" onClick="closeModal();"><i class="fas fa-times"></i> Annuler</a>
    </div>

    <div id="preview" style="overflow:hidden; width:90px; height:90px; position:absolute; top:10px; right:10px; border:1px solid #ccc; border-radius:4px;">
        <img src="" style="position:relative;" alt="Preview" />
    </div>

    <div style="margin-top:10px;">
        <img id="largeimg" src="{{ image }}" style="max-width:100%;">
    </div>
{% endblock %}

{% block localscript %}
    <script>
        function preview(img, selection) {
            var scaleX = 90 / selection.width;
            var scaleY = 90 / selection.height;
            $('#preview img').css({
                width: Math.round(scaleX * $('#largeimg').width()) + 'px',
                height: Math.round(scaleY * $('#largeimg').height()) + 'px',
                marginLeft: '-' + Math.round(scaleX * selection.x1) + 'px',
                marginTop: '-' + Math.round(scaleY * selection.y1) + 'px'
            });
            $('#crop_x1').val(selection.x1);
            $('#crop_y1').val(selection.y1);
            $('#crop_w').val(selection.width);
            $('#crop_h').val(selection.height);
        }

        function closeModal() {
            var parentDoc = window.parent.document;
            var modals = parentDoc.querySelectorAll('.modal.show');
            for (var i = 0; i < modals.length; i++) {
                var bsModal = window.parent.bootstrap.Modal.getInstance(modals[i]);
                if (bsModal) bsModal.hide();
            }
        }

        $(window).on("load", function () {
            $('#largeimg').imgAreaSelect({ aspectRatio: '1:1', onSelectChange: preview, x1: 0, y1: 0, x2: 0, y2: 0 });

            $('#cropSubmit').on('click', function () {
                var x1 = $('#crop_x1').val();
                var y1 = $('#crop_y1').val();
                var w = $('#crop_w').val();
                var h = $('#crop_h').val();

                if (!w || !h || parseInt(w) <= 0) {
                    alert('Veuillez sélectionner une zone de crop.');
                    return;
                }

                $.ajax({
                    url: '{{ path("bninefiles_files_crop", {domain: domain, id: id}) }}',
                    method: 'POST',
                    data: {
                        path: '{{ filePath }}',
                        x1: x1, y1: y1, w: w, h: h,
                        size: 150
                    },
                    success: function (response) {
                        if (response.success) {
                            if (typeof window.parent.imageUploadDone === 'function') {
                                window.parent.imageUploadDone(response.path);
                            }
                            closeModal();
                        }
                    },
                    error: function () {
                        alert('Erreur lors du crop.');
                    }
                });
            });
        });
    </script>

    <input type="hidden" id="crop_x1" value="0">
    <input type="hidden" id="crop_y1" value="0">
    <input type="hidden" id="crop_w" value="0">
    <input type="hidden" id="crop_h" value="0">
{% endblock %}
