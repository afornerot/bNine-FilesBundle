{% extends 'base.html.twig' %}

{% block localstyle %}
    <style>
        body { background-color: transparent; }
    </style>
{% endblock %}

{% block body %}
    <div class="d-flex gap-2 mb-2">
        <button type="button" class="btn btn-success btn-sm" id="cropSubmit"><i class="fas fa-check"></i> Valider</button>
        <a class="btn btn-secondary btn-sm" onclick="window.parent.BnineModalClose();"><i class="fas fa-times"></i> Annuler</a>
    </div>

    <div id="preview" style="overflow:hidden; width:90px; height:90px; position:absolute; top:10px; right:10px; border:1px solid #ccc; border-radius:4px;">
        <img src="{{ image }}" style="position:relative;" alt="Preview" />
    </div>

    <div style="margin-top:10px;">
        <img id="largeimg" src="{{ image }}" style="max-width:100%;">
    </div>
{% endblock %}

{% block localscript %}
    <script>
        var naturalWidth = 0;
        var naturalHeight = 0;

        function preview(img, selection) {
            if (!selection.width || !selection.height) return;
            var $largeImg = $('#largeimg');
            var displayedWidth = $largeImg.width();
            var displayedHeight = $largeImg.height();
            var ratioX = naturalWidth / displayedWidth;
            var ratioY = naturalHeight / displayedHeight;

            var cropW = selection.width * ratioX;
            var cropH = selection.height * ratioY;

            var scale = Math.min(90 / cropW, 90 / cropH);

            $('#preview img').css({
                width: Math.round(naturalWidth * scale) + 'px',
                height: Math.round(naturalHeight * scale) + 'px',
                marginLeft: '-' + Math.round(selection.x1 * ratioX * scale) + 'px',
                marginTop: '-' + Math.round(selection.y1 * ratioY * scale) + 'px'
            });
        }

        $(document).ready(function () {
            var $img = $('#largeimg');

            $img.on('load', function () {
                naturalWidth = this.naturalWidth;
                naturalHeight = this.naturalHeight;
            });

            if ($img[0].complete) {
                naturalWidth = $img[0].naturalWidth;
                naturalHeight = $img[0].naturalHeight;
            }

            $img.imgAreaSelect({
                aspectRatio: '1:1',
                onSelectChange: preview,
                x1: 0, y1: 0, x2: 0, y2: 0
            });

            $('#cropSubmit').on('click', function () {
                var ias = $img.imgAreaSelect({ instance: true });
                var sel = ias.getSelection();

                if (!sel || sel.width <= 0 || sel.height <= 0) {
                    alert('Veuillez sélectionner une zone de crop.');
                    return;
                }

                var ratioX = naturalWidth / $img.width();
                var ratioY = naturalHeight / $img.height();

                $.ajax({
                    url: '{{ path("bninefiles_files_crop", {domain: domain, id: id}) }}',
                    method: 'POST',
                    data: {
                        path: '{{ filePath }}',
                        x1: Math.round(sel.x1 * ratioX),
                        y1: Math.round(sel.y1 * ratioY),
                        w: Math.round(sel.width * ratioX),
                        h: Math.round(sel.height * ratioY),
                        size: 150
                    },
                    success: function (response) {
                        if (response.success) {
                            window.parent.imageUploadDone(response.path, response.url);
                        }
                    },
                    error: function (xhr) {
                        alert('Erreur lors du crop.\n' + (xhr.responseText || xhr.statusText));
                    }
                });
            });
        });
    </script>
{% endblock %}
