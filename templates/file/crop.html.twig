<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Crop</title>
    {{ include('@BnineFiles/partials/_iframe_assets.html.twig', { _iframe_context: 'crop' }) }}
    <style>body { background-color: transparent; }</style>
</head>
<body>
    <div class="d-flex gap-2 mb-2 flex-wrap align-items-center">
        <button type="button" class="btn btn-success btn-sm" id="cropSubmit"><i class="fas fa-check"></i> Valider</button>
        <a class="btn btn-secondary btn-sm" onclick="window.parent.BnineModalClose();"><i class="fas fa-times"></i> Annuler</a>

        {# Champs min_size et ratio : affichés uniquement si configurable=true #}
        {% if configurable %}
            <div class="vr"></div>

            <div class="input-group input-group-sm" style="width: auto;">
                <span class="input-group-text" title="Taille minimale finale (largeur ET hauteur)">Min&nbsp;(px)</span>
                <input type="number" id="minSize" name="min_size" class="form-control"
                       value="{{ minSize }}" min="50" max="2000" step="10"
                       style="width: 80px;"
                       title="Dimension minimale finale : si le crop est plus petit, l'image est agrandie pour atteindre cette valeur.">
            </div>

            <div class="input-group input-group-sm" style="width: auto;">
                <span class="input-group-text" title="Ratio largeur/hauteur (ou 'free')">Ratio</span>
                <input type="text" id="ratio" name="ratio" class="form-control"
                       value="{{ ratio }}"
                       list="ratioPresets"
                       style="width: 80px;"
                       placeholder="1/1, 16/9, free..."
                       pattern="^(free|\d+(\.\d+)?\s*[:\/]\s*\d+(\.\d+)?)$"
                       title="Ratio largeur/hauteur (ex: 1/1, 3/4, 4/3, 16/9) ou 'free' pour libre.">
                <datalist id="ratioPresets">
                    <option value="1/1">
                    <option value="3/4">
                    <option value="4/3">
                    <option value="16/9">
                    <option value="16/10">
                    <option value="21/9">
                    <option value="2/3">
                    <option value="3/2">
                    <option value="9/16">
                    <option value="free">
                </datalist>
            </div>
        {% else %}
            {# Champs cachés : envoyés quand même dans le POST pour conserver les valeurs #}
            <input type="hidden" id="minSize" name="min_size" value="{{ minSize }}">
            <input type="hidden" id="ratio" name="ratio" value="{{ ratio }}">
        {% endif %}
    </div>

    <div style="margin-top:10px; max-height:500px;">
        <img id="largeimg" src="{{ image }}" style="max-width:100%;">
    </div>

    <script>
    $(function () {
        var $img = $('#largeimg');
        var $minSize = $('#minSize');
        var $ratio = $('#ratio');
        var cropper = null;

        // Parse un ratio "16/9" ou "4:3" → nombre décimal, ou "free" → NaN
        function parseRatio(s) {
            if (!s || s === 'free') return NaN;
            var m = s.match(/^(\d+(?:\.\d+)?)\s*[:\/]\s*(\d+(?:\.\d+)?)$/);
            if (!m) return NaN;
            return parseFloat(m[1]) / parseFloat(m[2]);
        }

        function rebuild() {
            if (cropper) {
                cropper.destroy();
                cropper = null;
            }
            var aspectRatio = parseRatio($ratio.val());
            cropper = new Cropper($img[0], {
                aspectRatio: aspectRatio,
                viewMode: 1,
                autoCropArea: 1,
                responsive: true,
                background: false,
            });
        }

        $img.on('load', rebuild);
        if ($img[0].complete && $img[0].naturalWidth) {
            rebuild();
        }

        // Quand l'user change le ratio, on reconstruit Cropper (uniquement si configurable)
        $ratio.on('change', function () {
            // On ne reconstruit que si l'input est visible (pas un hidden)
            if ($ratio.is(':visible')) {
                rebuild();
            }
        });

        $('#cropSubmit').on('click', function () {
            if (!cropper) {
                alert('Image non chargée.');
                return;
            }

            var data = cropper.getData(true);
            if (!data.width || !data.height) {
                alert('Veuillez sélectionner une zone de crop.');
                return;
            }

            // Validation min_size côté client
            var minSize = parseInt($minSize.val(), 10) || 300;
            if (minSize < 50) minSize = 50;
            if (minSize > 2000) minSize = 2000;

            var ratioValue = $ratio.val() || '1/1';

            $.ajax({
                url: '{{ path("bninefiles_files_crop", {domain: domain, id: id}) }}',
                method: 'POST',
                data: {
                    path: '{{ filePath }}',
                    x1: Math.round(data.x),
                    y1: Math.round(data.y),
                    w: Math.round(data.width),
                    h: Math.round(data.height),
                    min_size: minSize,
                    ratio: ratioValue
                },
                success: function (response) {
                    if (response.success) {
                        // Recuperer l'origin depuis l'URL
                        var urlParams = new URLSearchParams(window.location.search);
                        var origin = urlParams.get('origin') || null;

                        // Dispatcher bnine:crop:done vers le parent
                        var detail = {
                            domain: '{{ domain }}',
                            id: '{{ id }}',
                            path: response.path,
                            url: response.url,
                            origin: origin,
                        };
                        try {
                            var ev = new CustomEvent('bnine:crop:done', { detail: detail, bubbles: true });
                            window.parent.document.dispatchEvent(ev);
                        } catch (e) {
                            var ev2 = window.parent.document.createEvent('CustomEvent');
                            ev2.initCustomEvent('bnine:crop:done', true, false, detail);
                            window.parent.document.dispatchEvent(ev2);
                        }

                        window.parent.BnineModalClose();
                    } else {
                        // Dispatcher bnine:crop:error
                        var urlParams2 = new URLSearchParams(window.location.search);
                        var origin2 = urlParams2.get('origin') || null;
                        var errorDetail = {
                            message: response.error || 'inconnue',
                            origin: origin2,
                        };
                        try {
                            var ev3 = new CustomEvent('bnine:crop:error', { detail: errorDetail, bubbles: true });
                            window.parent.document.dispatchEvent(ev3);
                        } catch (e) {
                            var ev4 = window.parent.document.createEvent('CustomEvent');
                            ev4.initCustomEvent('bnine:crop:error', true, false, errorDetail);
                            window.parent.document.dispatchEvent(ev4);
                        }
                        alert('Erreur : ' + (response.error || 'inconnue'));
                    }
                },
                error: function (xhr) {
                    alert('Erreur lors du crop.\n' + (xhr.responseText || xhr.statusText));
                }
            });
        });
    });
    </script>
</body>
</html>
