{% extends 'base.html.twig' %}

{% set editable = app.request.query.get('editable', '1') %}
{% set is_write = editable == '1' %}

{% block title %}Browse - Sample{% endblock %}

{% block body %}
<div class="container">
    <h1><i class="fas fa-folder-open me-2"></i>Navigateur de fichiers</h1>
    <p class="text-muted">
        Domain <code>{{ domain }}</code> · Entity ID <code>{{ entity_id }}</code> ·
        Mode <code>{{ is_write ? 'write' : 'read' }}</code>
    </p>

    <ul class="nav nav-pills mb-3">
        <li class="nav-item">
            <a class="nav-link {{ is_write ? 'active' : '' }}" href="?editable=1">
                <i class="fas fa-pen me-1"></i> Mode écriture
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{ not is_write ? 'active' : '' }}" href="?editable=0">
                <i class="fas fa-eye me-1"></i> Mode lecture
            </a>
        </li>
    </ul>

    <p class="text-muted small">
        {% if is_write %}
            <i class="fas fa-info-circle me-1"></i> Mode écriture : upload, création de sous-dossiers et suppression.
        {% else %}
            <i class="fas fa-info-circle me-1"></i> Mode lecture : navigation et téléchargement uniquement.
        {% endif %}
    </p>

    {# === Rendu du navigateur via le contrôleur du bundle === #}
    {% set html = render(controller(
        'Bnine\\FilesBundle\\Controller\\FileController::browse',
        { domain: domain, id: entity_id, editable: editable }
    )) %}
    {{ html|raw }}

    {# === Code d'usage === #}
    <div class="card mt-4">
        <div class="card-header"><i class="fas fa-code me-2"></i>Code d'usage</div>
        <div class="card-body">
            <h6 class="text-muted">1. Contrôleur (Symfony)</h6>
            <pre class="small bg-light p-3 rounded mb-4"><code>// src/Controller/DemoController.php
use Symfony\\Bundle\\FrameworkBundle\\Controller\\AbstractController;
use Symfony\\Component\\HttpFoundation\\Response;
use Symfony\\Component\\Routing\\Annotation\\Route;

class DemoController extends AbstractController
{
    #[Route('/browse', name: 'demo_browse')]
    public function browse(): Response
    {
        return $this->render('demo/browse.html.twig', [
            'domain'    =&gt; 'sample',   // sous-domaine de stockage (folder racine dans uploads/)
            'entity_id' =&gt; 1,           // id de l'entité propriétaire (sous-dossier uploads/{domain}/{id}/)
        ]);
    }
}</code></pre>

            <h6 class="text-muted">2. Template (Twig) — rendu du navigateur via le contrôleur du bundle</h6>
            <pre class="small bg-light p-3 rounded mb-4"><code>{% verbatim %}{# demo/browse.html.twig #}
{# Render le navigateur via FileController::browse() #}
{% set html = render(controller(
    'Bnine\\FilesBundle\\Controller\\FileController::browse',
    { domain: domain, id: entity_id, editable: 1 }
)) %}
{{ html|raw }}

{# editable: 1 = mode écriture (upload + dossier + suppression)
   editable: 0 = mode lecture (navigation + téléchargement uniquement) #}{% endverbatim %}</code></pre>

            <h6 class="text-muted">3. Paramètres de <code>FileController::browse()</code></h6>
            <table class="table table-sm table-bordered">
                <thead><tr><th>Param</th><th>Type</th><th>Obligatoire</th><th>Description</th></tr></thead>
                <tbody>
                    <tr><td><code>domain</code></td><td>string</td><td>oui</td><td>Sous-domaine de stockage. Crée le dossier <code>uploads/{domain}/{id}/</code>.</td></tr>
                    <tr><td><code>id</code></td><td>string|int</td><td>oui</td><td>Identifiant de l'entité propriétaire. Utilisé comme sous-dossier.</td></tr>
                    <tr><td><code>editable</code></td><td>0|1</td><td>non (défaut <code>1</code>)</td><td>1 = boutons upload/dossier/suppression, 0 = lecture seule.</td></tr>
                    <tr><td><code>compact</code></td><td>0|1</td><td>non (défaut <code>0</code>)</td><td>1 = retire les wrappers card/header pour intégration dans une autre UI.</td></tr>
                    <tr><td><code>path</code></td><td>string</td><td>non</td><td>Sous-dossier courant à l'intérieur de <code>{domain}/{id}/</code>. Passé en query string.</td></tr>
                </tbody>
            </table>

            <h6 class="text-muted">4. Sécurité (Voter)</h6>
            <p class="small">
                Chaque requête passe par <code>App\Security\FileVoter</code> qui décide si l'utilisateur courant
                peut <code>list</code>, <code>upload</code>, <code>delete</code>, <code>mkdir</code>, <code>download</code>
                pour le couple <code>(domain, id)</code>. En mode démo, le voter autorise tout.
            </p>
            <pre class="small bg-light p-3 rounded mb-4"><code>// src/Security/FileVoter.php
use Bnine\\FilesBundle\\Security\\AbstractFileVoter;
use Symfony\\Component\\Security\\Core\\Authentication\\Token\\TokenInterface;
use Symfony\\Component\\Security\\Core\\Authorization\\Voter\\Voter;

class FileVoter extends AbstractFileVoter
{
    protected function supports(string $attribute, mixed $subject): bool
    {
        return in_array($attribute, ['list', 'upload', 'delete', 'mkdir', 'download'], true);
    }

    protected function voteOnAttribute(string $attribute, mixed $subject, TokenInterface $token): bool
    {
        // En prod : restreindre par utilisateur, rôle, ou domain/id
        return true; // démo : tout le monde a accès
    }
}</code></pre>

            <h6 class="text-muted">5. Routes du bundle utilisées</h6>
            <table class="table table-sm table-bordered">
                <thead><tr><th>Route</th><th>Méthode</th><th>Rôle</th></tr></thead>
                <tbody>
                    <tr><td><code>bninefiles_files</code></td><td>GET</td><td>Rendu du navigateur (ré-appelé en AJAX lors de la navigation).</td></tr>
                    <tr><td><code>bninefiles_files_uploadmodal</code></td><td>GET</td><td>Page d'upload (iframe) avec Dropzone.</td></tr>
                    <tr><td><code>bninefiles_files_uploadfile</code></td><td>POST</td><td>Upload effectif du fichier (multipart).</td></tr>
                    <tr><td><code>bninefiles_files_delete</code></td><td>POST</td><td>Suppression d'un fichier/dossier.</td></tr>
                    <tr><td><code>bninefiles_files_mkdir</code></td><td>POST</td><td>Création d'un sous-dossier.</td></tr>
                    <tr><td><code>bninefiles_files_download</code></td><td>GET</td><td>Téléchargement d'un fichier.</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}