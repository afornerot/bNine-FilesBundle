{% extends 'base.html.twig' %}

{# Toutes les options d'IconUploadType, calculées une seule fois via le router Symfony. #}
{% set _iconDomain = 'avatar' %}
{% set _iconId = 0 %}

{# URLs d'upload pré-calculées pour chaque variante (avec ou sans crop, configurables ou non). #}
{% set _url_crop_300_1_1 = path('bninefiles_files_uploadmodal', {domain: _iconDomain, id: _iconId, crop: 1}) %}
{% set _url_crop_400_16_9 = path('bninefiles_files_uploadmodal', {domain: _iconDomain, id: _iconId, crop: 1, min_size: 400, ratio: '16/9', configurable: 1}) %}
{% set _url_crop_250_3_4 = path('bninefiles_files_uploadmodal', {domain: _iconDomain, id: _iconId, crop: 1, min_size: 250, ratio: '3/4', configurable: 1}) %}
{% set _url_crop_200_free = path('bninefiles_files_uploadmodal', {domain: _iconDomain, id: _iconId, crop: 1, min_size: 200, ratio: 'free', configurable: 1}) %}
{% set _url_no_crop = path('bninefiles_files_uploadmodal', {domain: _iconDomain, id: _iconId}) %}

{% block title %}Icon - Sample{% endblock %}

{% block body %}
<div class="container">
    <h1><i class="fas fa-user-circle me-2"></i>Icône avec / sans crop</h1>
    <p class="text-muted">
        Démontre <code>IconUploadType</code> utilisé hors Form Type (input HTML brut + JS du bundle).
        Les options <code>crop</code>, <code>crop_min_size</code>, <code>crop_ratio</code>,
        <code>crop_configurable</code> et <code>preview_max_height</code> sont passées au template
        de crop via les query params de l'URL d'upload.
    </p>

    {# ============ Démo 1 : crop carré non configurable ============ #}
    <div class="card">
        <div class="card-body">
            <h5>1. Avatar carré 300x300 — <code>configurable=false</code> (défaut)</h5>
            <p class="text-muted small">
                Champs <code>min_size</code> et <code>ratio</code> <strong>cachés</strong> : l'utilisateur ne peut pas les modifier.
                Preview limitée à <code>100px</code> (défaut).
            </p>
            <form>
                <label class="form-label">Avatar carré</label>
                <input type="text"
                       class="form-control icon-input"
                       id="avatar-square"
                       value=""
                       data-icon-endpoint="avatar"
                       data-icon-label="Avatar carré"
                       data-icon-empty-preview=""
                       data-preview-max-height="100"
                       data-upload-url="{{ _url_crop_300_1_1 }}">
            </form>
        </div>
    </div>

    {# ============ Démo 2 : crop bannière 16/9 configurable ============ #}
    <div class="card mt-4">
        <div class="card-body">
            <h5>2. Avatar bannière 16/9 — <code>configurable=true</code>, <code>preview_max_height=250</code></h5>
            <p class="text-muted small">
                Champs <code>min_size</code> et <code>ratio</code> <strong>visibles</strong> dans la modale crop.
                Le thumb de retour est affiché avec une hauteur max de <code>250px</code>.
            </p>
            <form>
                <label class="form-label">Avatar bannière</label>
                <input type="text"
                       class="form-control icon-input"
                       id="avatar-banner"
                       value=""
                       data-icon-endpoint="avatar"
                       data-icon-label="Bannière"
                       data-icon-empty-preview=""
                       data-preview-max-height="250"
                       data-upload-url="{{ _url_crop_400_16_9 }}">
            </form>
        </div>
    </div>

    {# ============ Démo 3 : crop portrait 3/4 configurable ============ #}
    <div class="card mt-4">
        <div class="card-body">
            <h5>3. Avatar portrait 3/4 — <code>configurable=true</code>, <code>preview_max_height=200</code></h5>
            <form>
                <label class="form-label">Avatar portrait</label>
                <input type="text"
                       class="form-control icon-input"
                       id="avatar-portrait"
                       value=""
                       data-icon-endpoint="avatar"
                       data-icon-label="Portrait"
                       data-icon-empty-preview=""
                       data-preview-max-height="200"
                       data-upload-url="{{ _url_crop_250_3_4 }}">
            </form>
        </div>
    </div>

    {# ============ Démo 4 : crop libre (ratio=free) configurable ============ #}
    <div class="card mt-4">
        <div class="card-body">
            <h5>4. Avatar libre — <code>ratio=free</code>, <code>configurable=true</code>, <code>preview_max_height=300</code></h5>
            <p class="text-muted small">
                Ratio libre : l'utilisateur peut sélectionner n'importe quelle zone.
                Le thumb de retour est affiché avec une hauteur max de <code>300px</code>.
            </p>
            <form>
                <label class="form-label">Avatar libre</label>
                <input type="text"
                       class="form-control icon-input"
                       id="avatar-free"
                       value=""
                       data-icon-endpoint="avatar"
                       data-icon-label="Libre"
                       data-icon-empty-preview=""
                       data-preview-max-height="300"
                       data-upload-url="{{ _url_crop_200_free }}">
            </form>
        </div>
    </div>

    {# ============ Démo 5 : upload SANS crop ============ #}
    <div class="card mt-4">
        <div class="card-body">
            <h5>5. Upload SANS crop — fichier simple</h5>
            <p class="text-muted small">
                Pas de recadrage : l'URL d'upload <strong>n'inclut pas</strong> <code>crop</code>.
                La modale affiche uniquement DropzoneJS, pas de CropperJS.
                Pour les domaines publics (<code>avatar</code>, <code>logo</code>, <code>icon</code>),
                le controller crée automatiquement un thumb (copie) et renvoie le path du thumb au widget.
            </p>
            <form>
                <label class="form-label">Pièce jointe (sans crop)</label>
                <input type="text"
                       class="form-control icon-input"
                       id="file-simple"
                       value=""
                       data-icon-endpoint="avatar"
                       data-icon-label="Pièce jointe"
                       data-icon-empty-preview=""
                       data-preview-max-height="150"
                       data-upload-url="{{ _url_no_crop }}">
            </form>
        </div>
    </div>

    {# ============ Démo 6 : utilisation de bninefile() ============ #}
    <div class="card mt-4">
        <div class="card-body">
            <h5>6. Fonction Twig <code>bninefile()</code> — résolution d'URL</h5>
            <p>Une fois un fichier uploadé, son chemin est stocké dans l'input. Pour l'afficher :</p>
            <pre class="small bg-light p-3 rounded mb-2"><code>&lt;img src=&quot;{{ '{{ bninefile(article.avatar) }}' }}&quot;&gt;</code></pre>
            <p class="small mb-0">Résultat (exemple fictif) :</p>
            <pre class="small bg-light p-3 rounded mb-2"><code>&lt;img src="{{ bninefile('avatar/0/abc123.jpg') }}"&gt;        → &lt;img src="/bninefiles/image/avatar/0?path=abc123.jpg"&gt;</code></pre>
            <p class="small text-muted mb-0">
                Pour les crops, le path retourné est du type <code>_thumbs/{path-non-thumb}/{file}.{ext}</code>
                (ex: <code>_thumbs/avatar/0/abc123.jpg</code>).
            </p>
        </div>
    </div>

    {# ============ Code d'usage complet ============ #}
    <div class="card mt-4">
        <div class="card-header"><i class="fas fa-code me-2"></i>Code d'usage (HTML brut + JS du bundle)</div>
        <div class="card-body">
            <h6 class="text-muted">1. Activation du JS</h6>
            <p class="small">
                Charger jQuery et le JS du bundle <strong>une seule fois</strong> dans le layout :
            </p>
            <pre class="small bg-light p-3 rounded mb-4"><code>{% verbatim %}{# templates/base.html.twig #}
&lt;script src=&quot;{{ asset('bundles/bninefiles/lib/js/jquery.min.js') }}&quot;&gt;&lt;/script&gt;
&lt;script src=&quot;{{ asset('bundles/bninefiles/js/bninefiles.js') }}&quot;&gt;&lt;/script&gt;{% endverbatim %}</code></pre>

            <h6 class="text-muted">2. Markup HTML minimal</h6>
            <p class="small">
                Un simple <code>&lt;input type="text" class="icon-input"&gt;</code> avec quelques <code>data-*</code>.
                Le JS du bundle détecte <code>.icon-input</code> au <code>$(document).ready</code> et :
            </p>
            <ul class="small">
                <li>ajoute un wrapper <code>.icon-wrapper</code> + une preview <code>&lt;img&gt;</code> avec <code>max-height = preview-max-height</code>,</li>
                <li>ajoute un bouton « Modifier » qui ouvre la modale d'upload via <code>BnineModalOpen()</code>,</li>
                <li>écoute l'event <code>imageUploadDone(path, url)</code> du parent pour mettre à jour la preview + la valeur de l'input.</li>
            </ul>
            <pre class="small bg-light p-3 rounded mb-4"><code>{% verbatim %}{% set uploadUrl = path('bninefiles_files_uploadmodal', {domain: 'avatar', id: 0, crop: 1}) %}
&lt;input type="text"
       class="form-control icon-input"
       id="my-avatar"
       value=""
       data-icon-endpoint="avatar"
       data-icon-label="Avatar"
       data-icon-empty-preview=""
       data-preview-max-height="100"
       data-upload-url="{{ uploadUrl }}">
{% endverbatim %}</code></pre>

            <h6 class="text-muted">3. Data attributes reconnus par <code>bninefiles.js</code></h6>
            <table class="table table-sm table-bordered">
                <thead><tr><th>Attribut</th><th>Type</th><th>Défaut</th><th>Description</th></tr></thead>
                <tbody>
                    <tr><td><code>data-upload-url</code></td><td>string</td><td>—</td><td><strong>Obligatoire</strong>. URL de la modale d'upload (route <code>bninefiles_files_uploadmodal</code>).</td></tr>
                    <tr><td><code>data-icon-label</code></td><td>string</td><td><code>"Icon"</code></td><td>Titre de la modale d'upload.</td></tr>
                    <tr><td><code>data-icon-endpoint</code></td><td>string</td><td>—</td><td>Domaine (utilisé pour les hooks applicatifs, non requis pour le rendu).</td></tr>
                    <tr><td><code>data-icon-empty-preview</code></td><td>string</td><td>—</td><td>URL d'une image placeholder quand l'input est vide.</td></tr>
                    <tr><td><code>data-preview-max-height</code></td><td>int</td><td><code>100</code></td><td>Hauteur max (en px) de la preview dans le widget parent.</td></tr>
                    <tr><td><code>value</code></td><td>string</td><td>—</td><td>Chemin retourné par le bundle après upload (préfixé <code>_thumbs/</code> pour les domaines publics).</td></tr>
                </tbody>
            </table>

            <h6 class="text-muted">4. Query params acceptés par <code>bninefiles_files_uploadmodal</code></h6>
            <p class="small">Ces params sont passés en query string dans <code>data-upload-url</code> :</p>
            <table class="table table-sm table-bordered">
                <thead><tr><th>Param</th><th>Type</th><th>Défaut</th><th>Description</th></tr></thead>
                <tbody>
                    <tr><td><code>crop</code></td><td>0|1</td><td><code>0</code></td><td>Active le recadrage après upload. Sans <code>crop=1</code>, la modale affiche DropzoneJS seul.</td></tr>
                    <tr><td><code>min_size</code></td><td>int</td><td><code>300</code></td><td>Taille minimale finale (largeur ET hauteur), bornes 50–2000.</td></tr>
                    <tr><td><code>ratio</code></td><td>string</td><td><code>"1/1"</code></td><td>Ratio largeur/hauteur (<code>1/1</code>, <code>16/9</code>, <code>4/3</code>, <code>free</code>, …).</td></tr>
                    <tr><td><code>configurable</code></td><td>0|1</td><td><code>0</code></td><td>1 = champs min_size et ratio éditables dans la modale crop.</td></tr>
                    <tr><td><code>path</code></td><td>string</td><td>—</td><td>Sous-dossier de destination dans <code>uploads/{domain}/{id}/</code>.</td></tr>
                </tbody>
            </table>

            <h6 class="text-muted">5. Callback JS <code>window.imageUploadDone()</code></h6>
            <p class="small">
                Quand l'upload (et éventuellement le crop) est terminé, l'iframe enfant appelle
                <code>window.parent.imageUploadDone(filepath, fileUrl)</code> où :
            </p>
            <ul class="small">
                <li><code>filepath</code> = chemin relatif à stocker dans l'input (préfixé <code>_thumbs/</code> pour les domaines publics).</li>
                <li><code>fileUrl</code> = URL absolue pour la preview (<code>/bninefiles/image/{domain}/{id}?path=...</code>).</li>
            </ul>
            <p class="small">
                Pour un usage hors Form Type (cette page), c'est le JS du bundle qui écoute et met à jour l'input + la preview.
                Pour un usage en Form Type, c'est le Form Type qui construit automatiquement ces data-attributes.
            </p>
        </div>
    </div>
</div>
{% endblock %}