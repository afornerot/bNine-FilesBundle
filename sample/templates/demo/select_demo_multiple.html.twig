{% extends 'base.html.twig' %}

{% block title %}Demo : sélection multiple{% endblock %}

{% block body %}
<div class="container">
    <h1><i class="fas fa-images me-2"></i>Démo widget multiple</h1>
    <p class="text-muted">
        Formulaire HTML simple utilisant le widget
        <code>@BnineFilesBundle/file/_select.html.twig</code> en mode <strong>multiple</strong>.
        Les chemins sont stockés en JSON array dans l'input caché.
    </p>

    {# ============ Démo 1 : write + inline + grid_cols 6 ============ #}
    <div class="card">
        <div class="card-body">
            <h5>1. Mode <code>write</code> + layout <code>inline</code> + grille 6 colonnes</h5>
            <p class="text-muted small">
                Modale avec upload / dossier / suppression. Sélection additive : on peut ajouter
                plusieurs images en plusieurs ouvertures de modale (pas de doublons).
            </p>
            <form id="demo-form-multiple" onsubmit="event.preventDefault(); alert('Valeur envoyée :\\n' + document.querySelector('[name=&quot;gallery[images]&quot;]').value);">
                <div class="mb-3">
                    <label class="form-label">Titre</label>
                    <input type="text" class="form-control" placeholder="Mon diaporama" value="Mes photos préférées">
                </div>

                <div class="mb-3">
                    {% include '@BnineFilesBundle/file/_select.html.twig' with {
                        mode: 'multiple',
                        access: 'write',
                        layout: 'inline',
                        input_name: 'gallery[images]',
                        domain: domain,
                        entity_id: entity_id,
                        value: images,
                        label: 'Galerie d\'images',
                        required: false,
                        show_name: true,
                        grid_cols: 6
                    } only %}
                </div>

                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save me-1"></i>Enregistrer
                </button>
            </form>
        </div>
    </div>

    {# ============ Démo 2 : column + grille 8 colonnes ============ #}
    <div class="card mt-4">
        <div class="card-body">
            <h5>2. Mode <code>write</code> + layout <code>column</code> + grille 8 colonnes</h5>
            <p class="text-muted small">
                Boutons en haut à gauche, grille 8 colonnes en dessous. Convient pour les galeries
                denses avec beaucoup de vignettes.
            </p>

            {% set _demo_items = [
                {url: path('bninefiles_files_image', {domain: domain, id: entity_id}) ~ '?path=01-008.jpg', path: 'sample/1/01-008.jpg', name: '01-008.jpg'},
                {url: path('bninefiles_files_image', {domain: domain, id: entity_id}) ~ '?path=02-030.jpg', path: 'sample/1/02-030.jpg', name: '02-030.jpg'},
                {url: path('bninefiles_files_image', {domain: domain, id: entity_id}) ~ '?path=03-06.jpg', path: 'sample/1/03-06.jpg', name: '03-06.jpg'},
                {url: path('bninefiles_files_image', {domain: domain, id: entity_id}) ~ '?path=04-066.jpg', path: 'sample/1/04-066.jpg', name: '04-066.jpg'},
            ] %}

            {% include '@BnineFilesBundle/file/_select.html.twig' with {
                mode: 'multiple',
                access: 'write',
                layout: 'column',
                input_name: 'gallery[images_column]',
                domain: domain,
                entity_id: entity_id,
                value: _demo_items|json_encode,
                label: 'Galerie column (grid 8)',
                show_name: false,
                grid_cols: 8
            } only %}
        </div>
    </div>

    {# ============ Démo 3 : access=read ============ #}
    <div class="card mt-4">
        <div class="card-body">
            <h5>3. Mode <code>read</code> — lecture seule</h5>
            <p class="text-muted small">
                Modale en navigation seule (pas d'upload / pas de dossier / pas de suppression).
                Sélection additive conservée.
            </p>

            {% set _fake = [
                {url: path('bninefiles_files_image', {domain: domain, id: entity_id}) ~ '?path=01-008.jpg', path: 'sample/1/01-008.jpg', name: '01-008.jpg'},
                {url: path('bninefiles_files_image', {domain: domain, id: entity_id}) ~ '?path=02-030.jpg', path: 'sample/1/02-030.jpg', name: '02-030.jpg'},
                {url: path('bninefiles_files_image', {domain: domain, id: entity_id}) ~ '?path=03-06.jpg', path: 'sample/1/03-06.jpg', name: '03-06.jpg'},
            ] %}

            {% include '@BnineFilesBundle/file/_select.html.twig' with {
                mode: 'multiple',
                access: 'read',
                input_name: 'gallery[images_display]',
                domain: domain,
                entity_id: entity_id,
                value: _fake|json_encode,
                label: 'Galerie en lecture seule',
                show_name: true,
                grid_cols: 5
            } only %}
        </div>
    </div>

    {# ============ Code d'usage ============ #}
    <div class="card mt-4">
        <div class="card-header"><i class="fas fa-code me-2"></i>Code d'usage</div>
        <div class="card-body">

            <h6 class="text-muted">1. Contrôleur</h6>
            <pre class="small bg-light p-3 rounded mb-4"><code>// src/Controller/DemoController.php
#[Route('/select-demo-multiple', name: 'demo_select_multiple')]
public function selectDemoMultiple(): Response
{
    return $this-&gt;render('demo/select_demo_multiple.html.twig', [
        'domain'    =&gt; 'sample',
        'entity_id' =&gt; 1,
        'images'    =&gt; [],  // array de strings (ou JSON string)
    ]);
}</code></pre>

            <h6 class="text-muted">2. Inclusion du widget — toutes les options</h6>
            <pre class="small bg-light p-3 rounded mb-4"><code>{% verbatim %}{% include '@BnineFilesBundle/file/_select.html.twig' with {
    mode: 'multiple',                # 'single' (1 image) ou 'multiple' (N images)

    access: 'write',                 # 'write' = upload/dossier/suppression
                                     # 'read'  = navigation seule

    layout: 'inline',                # 'inline' (preview|boutons) ou 'column' (preview/boutons)

    input_name: 'gallery[images]',   # name du input hidden (JSON array envoyé)
    domain: 'avatar',                # domaine de stockage
    entity_id: 0,                    # id de l'entité propriétaire

    value: images,                   # array de strings OU JSON string
                                     # Format de string : 'domain/id/path'
                                     # ex: ['sample/1/01.jpg', 'sample/1/02.jpg']
                                     # ex: '["sample/1/01.jpg","sample/1/02.jpg"]'

    label: 'Galerie d\'images',      # libellé affiché au-dessus (optionnel)
    required: false,                 # ajoute l'attribut HTML required sur l'input

    show_name: true,                 # affiche le nom du fichier sous chaque vignette
    max_height: 100,                 # hauteur max de la preview (px, défaut 100)
    grid_cols: 6,                    # nb colonnes de la grille (défaut 4)
    placeholder: 'Aucune image sélectionnée',  # placeholder vide (défaut auto)
} only %}{% endverbatim %}</code></pre>

            <h6 class="text-muted">3. Récapitulatif des options (mode multiple)</h6>
            <table class="table table-sm table-bordered">
                <thead><tr><th>Option</th><th>Type</th><th>Défaut</th><th>Description</th></tr></thead>
                <tbody>
                    <tr><td><code>mode</code></td><td>string</td><td><code>'single'</code></td><td><code>'multiple'</code> ici = N images (stocke un JSON array).</td></tr>
                    <tr><td><code>access</code></td><td>string</td><td><code>'write'</code></td><td><code>'write'</code> = modale avec upload/dossier/suppression, <code>'read'</code> = modale en sélection seule.</td></tr>
                    <tr><td><code>layout</code></td><td>string</td><td><code>'inline'</code></td><td><code>'inline'</code> = preview|boutons, <code>'column'</code> = preview/boutons.</td></tr>
                    <tr><td><code>input_name</code></td><td>string</td><td>auto</td><td>Nom HTML de l'input caché.</td></tr>
                    <tr><td><code>input_id</code></td><td>string</td><td>auto</td><td>ID HTML de l'input caché.</td></tr>
                    <tr><td><code>domain</code></td><td>string</td><td><code>'uploads'</code></td><td>Domaine de stockage.</td></tr>
                    <tr><td><code>entity_id</code></td><td>int|string</td><td><code>0</code></td><td>ID de l'entité propriétaire.</td></tr>
                    <tr><td><code>value</code></td><td>array|string</td><td>—</td><td>Valeur initiale : array de strings OU JSON string sérialisé.</td></tr>
                    <tr><td><code>label</code></td><td>string</td><td>—</td><td>Libellé affiché au-dessus du widget.</td></tr>
                    <tr><td><code>required</code></td><td>bool</td><td><code>false</code></td><td>Ajoute <code>required</code> sur l'input caché.</td></tr>
                    <tr><td><code>show_name</code></td><td>bool</td><td><code>false</code></td><td>Affiche le nom du fichier sous chaque vignette.</td></tr>
                    <tr><td><code>max_height</code></td><td>int</td><td><code>100</code></td><td>Hauteur max de chaque vignette (px).</td></tr>
                    <tr><td><code>grid_cols</code></td><td>int</td><td><code>4</code></td><td>Nb colonnes de la grille.</td></tr>
                    <tr><td><code>placeholder</code></td><td>string</td><td>auto</td><td>Texte du placeholder vide.</td></tr>
                </tbody>
            </table>

            <h6 class="text-muted">4. Format de la valeur envoyée</h6>
            <p class="small">
                L'input caché envoie un <strong>JSON array de strings</strong> :
            </p>
            <pre class="small bg-light p-3 rounded mb-3"><code>{% verbatim %}{# POST request #}
gallery[images] = '["sample/1/01-008.jpg","sample/1/02-030.jpg","sample/1/03-06.jpg"]'

{# Controller #}
$json = $request-&gt;request-&gt;get('gallery')['images'] ?? '[]';
$paths = json_decode($json, true) ?: [];

{# Twig (affichage) #}
{% for p in paths %}
    &lt;img src="{{ '{{ bninefile(p) }}' }}"&gt;
{% endfor %}{% endverbatim %}</code></pre>

            <h6 class="text-muted">5. Comportement de sélection</h6>
            <ul class="small">
                <li><strong>Additif</strong> : on peut sélectionner en plusieurs fois, sans doublons (le widget dédoublonne par path).</li>
                <li><strong>Vider</strong> : le bouton « Vider » reset à <code>'[]'</code>.</li>
                <li><strong>Modale</strong> : ferme automatiquement la modale après validation.</li>
                <li><strong>Multi-instances</strong> : chaque widget a son propre inputId, pas d'interférence.</li>
            </ul>
        </div>
    </div>
</div>
{% endblock %}