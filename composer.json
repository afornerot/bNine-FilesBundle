{
    "name": "bnine/filesbundle",
    "description": "Symfony bundle for entity-based file browser and management.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "bundle",
        "files",
        "file-browser",
        "gallery",
        "thumbnails",
        "entity",
        "upload",
        "directory"
    ],
    "authors": [
        {
            "name": "afornerot",
            "email": "arno.nanor@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Bnine\\FilesBundle\\": "src/"
        }
    },
    "require": {
        "php": "^8.1",
        "symfony/framework-bundle": "^7.1",
        "symfony/form": "^7.1",
        "symfony/filesystem": "^7.1",
        "symfony/finder": "^7.1",
        "symfony/http-foundation": "^7.1",
        "symfony/http-kernel": "^7.1",
        "symfony/mime": "^7.1",
        "symfony/options-resolver": "^7.1",
        "symfony/routing": "^7.1",
        "symfony/security-core": "^7.1",
        "imagine/imagine": "^1.0",
        "league/flysystem": "^3.0",
        "league/flysystem-bundle": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "twig/twig": "^3.0",
        "psr/log": "^1.0|^2.0|^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.85"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev",
            "dev-master": "1.3-dev"
        }
    }
}